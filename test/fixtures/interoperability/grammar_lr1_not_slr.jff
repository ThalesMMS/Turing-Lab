<?xml version="1.0" encoding="UTF-8"?>
<structure type="grammar">
  <type>grammar</type>
  <grammar type="contextFree">
    <start>S</start>
    <production><left>S</left><right>L = R</right></production>
    <production><left>S</left><right>R</right></production>
    <production><left>L</left><right>* R</right></production>
    <production><left>L</left><right>i</right></production>
    <production><left>R</left><right>L</right></production>
  </grammar>
</structure>
